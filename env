# =============================================================================
# Elasticsearch 3-Node Cluster — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values before running docker compose.
# Never commit .env to source control — add it to .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# Cluster identity
# -----------------------------------------------------------------------------
CLUSTER_NAME=my-es-cluster

# Elasticsearch version — keep all services on the same version
ES_VERSION=8.13.4

# License tier: basic | trial | gold | platinum | enterprise
LICENSE=basic

# -----------------------------------------------------------------------------
# Credentials
# CHANGE THESE before first boot — these become the stored passwords.
# Requirements: min 6 chars, no leading/trailing whitespace.
# -----------------------------------------------------------------------------
ELASTIC_PASSWORD=changeme_elastic

# Used by Kibana to talk to Elasticsearch internally.
# After first boot, set this via the API (see README notes below).
KIBANA_PASSWORD=changeme_kibana

# -----------------------------------------------------------------------------
# JVM heap — set Xms == Xmx, no more than 50 % of available RAM,
# and never exceed 31 GB (compressed oops boundary).
# -----------------------------------------------------------------------------
ES_JAVA_OPTS=-Xms1g -Xmx1g

# -----------------------------------------------------------------------------
# Exposed ports (host-side)
# Only es01 is published on the host; es02/es03 are cluster-internal.
# -----------------------------------------------------------------------------
ES_PORT=9200
KIBANA_PORT=5601

# =============================================================================
# First-boot checklist
# =============================================================================
# 1. Set vm.max_map_count on the Docker host (required for ES):
#      sudo sysctl -w vm.max_map_count=262144
#    To persist across reboots, add to /etc/sysctl.conf:
#      vm.max_map_count=262144
#
# 2. Start the stack (setup container runs first, then nodes come up):
#      docker compose up -d
#
# 3. Once es01 is healthy, set the kibana_system password:
#      curl -s -X POST \
#        --cacert ./certs/ca/ca.crt \
#        -u "elastic:${ELASTIC_PASSWORD}" \
#        -H "Content-Type: application/json" \
#        https://localhost:9200/_security/user/kibana_system/_password \
#        -d "{\"password\":\"${KIBANA_PASSWORD}\"}"
#    Then restart Kibana: docker compose restart kibana
#
# 4. Verify cluster health:
#      curl -s --cacert ./certs/ca/ca.crt \
#        -u elastic:${ELASTIC_PASSWORD} \
#        https://localhost:9200/_cluster/health?pretty
#
# 5. Kibana is available at http://localhost:5601
#    Login: elastic / <ELASTIC_PASSWORD>
# =============================================================================
